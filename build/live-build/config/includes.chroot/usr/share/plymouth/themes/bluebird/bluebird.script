# BlueBird Kiosk OS boot/shutdown splash — premium "etched crest" theme.
#
# Layers (back->front): navy radial-glow background, a soft blue bloom, the
# cream Legacy Wall crest (blue keyed out so it floats and the glow shows
# through the engraving), and a row of gently-pulsing loader dots.
#
# MULTI-MONITOR (fixed 2026-06-22, measured on NEN's DP-1+HDMI kiosk):
#   - The original used the NO-ARG Window.GetWidth()/GetX(), which return canvas-level
#     dimensions; at shutdown that pushed the crest off-screen on both panels.
#   - Plymouth reports the active panel as WINDOW 0 with INDEXED geometry — e.g. 1920x1080
#     positioned at (960,540) inside a larger canvas — and Window.GetX(0)+GetWidth(0)/2 lands
#     exactly at the panel's physical centre (verified with an on-screen center marker).
#   - The window COUNT is unstable across shutdowns (sometimes 1, sometimes 2 overlapping
#     clones), so a per-window loop drew a DOUBLED crest. We therefore draw the crest exactly
#     ONCE, using window-0's indexed geometry: correct centre + never doubled.
#
# Animations run on the ~50Hz refresh callback, portable Plymouth-script only (counters + if).

# Window-0 INDEXED geometry (NOT the no-arg form — that returns canvas dims and mis-centres).
sw = Window.GetWidth (0);
sh = Window.GetHeight (0);
ox = Window.GetX (0);
oy = Window.GetY (0);

# Fallback colour for the instant before the image maps (deep navy, not flat brand-blue).
Window.SetBackgroundTopColor    (0.020, 0.027, 0.055);
Window.SetBackgroundBottomColor (0.012, 0.016, 0.035);

# -- Background: full-screen navy radial glow --
bg.image  = Image ("background.png");
bg.scaled = bg.image.Scale (sw, sh);
bg.sprite = Sprite (bg.scaled);
bg.sprite.SetX (ox);
bg.sprite.SetY (oy);
bg.sprite.SetZ (0);
bg.sprite.SetOpacity (0);

# -- Crest: cream emblem, ~30% screen width, centred a touch high --
em.image = Image ("emblem.png");
em_w  = sw * 0.30;
em_sc = em_w / em.image.GetWidth ();
em.scaled = em.image.Scale (em.image.GetWidth () * em_sc, em.image.GetHeight () * em_sc);
em.sprite = Sprite (em.scaled);
em_x = ox + (sw - em.scaled.GetWidth ()) / 2;
em_base_y = oy + (sh - em.scaled.GetHeight ()) / 2 - sh * 0.04;
em.sprite.SetX (em_x);
em.sprite.SetY (em_base_y);
em.sprite.SetZ (10);
em.sprite.SetOpacity (0);

# -- Bloom: soft blue glow behind the crest, breathing --
gl.image = Image ("glow.png");
gl_w  = em.scaled.GetWidth () * 1.55;
gl_sc = gl_w / gl.image.GetWidth ();
gl.scaled = gl.image.Scale (gl.image.GetWidth () * gl_sc, gl.image.GetHeight () * gl_sc);
gl.sprite = Sprite (gl.scaled);
em_cx = em_x + em.scaled.GetWidth () / 2;
em_cy = em_base_y + em.scaled.GetHeight () / 2;
gl.sprite.SetX (em_cx - gl.scaled.GetWidth () / 2);
gl.sprite.SetY (em_cy - gl.scaled.GetHeight () / 2);
gl.sprite.SetZ (5);
gl.sprite.SetOpacity (0);

# -- Loader dots: five, centred low, staggered pulse --
dot.image = Image ("dot.png");
dot_d  = sw * 0.010;
dot_sc = dot_d / dot.image.GetWidth ();
dot.scaled = dot.image.Scale (dot.image.GetWidth () * dot_sc, dot.image.GetHeight () * dot_sc);
dot_gap = dot_d * 2.0;
dots_total = dot_gap * 4;
dots_left = ox + (sw - dots_total) / 2 - dot.scaled.GetWidth () / 2;
dots_y = oy + sh * 0.80;

d0.sprite = Sprite (dot.scaled); d0.sprite.SetX (dots_left + dot_gap*0); d0.sprite.SetY (dots_y); d0.sprite.SetZ (8); d0.sprite.SetOpacity (0);
d1.sprite = Sprite (dot.scaled); d1.sprite.SetX (dots_left + dot_gap*1); d1.sprite.SetY (dots_y); d1.sprite.SetZ (8); d1.sprite.SetOpacity (0);
d2.sprite = Sprite (dot.scaled); d2.sprite.SetX (dots_left + dot_gap*2); d2.sprite.SetY (dots_y); d2.sprite.SetZ (8); d2.sprite.SetOpacity (0);
d3.sprite = Sprite (dot.scaled); d3.sprite.SetX (dots_left + dot_gap*3); d3.sprite.SetY (dots_y); d3.sprite.SetZ (8); d3.sprite.SetOpacity (0);
d4.sprite = Sprite (dot.scaled); d4.sprite.SetX (dots_left + dot_gap*4); d4.sprite.SetY (dots_y); d4.sprite.SetZ (8); d4.sprite.SetOpacity (0);

# -- Animation state --
tick = 0;
fade_total = 35;
settle_px  = sh * 0.022;

glow_phase  = 0;
glow_period = 170;

dot_period  = 90;
dot_stagger = 16;
d0_phase = 0;
d1_phase = dot_stagger * 1;
d2_phase = dot_stagger * 2;
d3_phase = dot_stagger * 3;
d4_phase = dot_stagger * 4;

fun tri (phase, period) {
    half = period / 2;
    if (phase < half) { return phase / half; }
    return (period - phase) / half;
}

fun refresh () {
    tick++;
    f = tick / fade_total;
    if (f > 1) { f = 1; }

    bg.sprite.SetOpacity (f);
    em.sprite.SetOpacity (f);
    em.sprite.SetY (em_base_y + settle_px * (1 - f));

    glow_phase++;
    if (glow_phase >= glow_period) { glow_phase = 0; }
    gb = 0.55 + 0.45 * tri (glow_phase, glow_period);
    gl.sprite.SetOpacity (gb * f);

    d0_phase++; if (d0_phase >= dot_period) { d0_phase = 0; }
    d1_phase++; if (d1_phase >= dot_period) { d1_phase = 0; }
    d2_phase++; if (d2_phase >= dot_period) { d2_phase = 0; }
    d3_phase++; if (d3_phase >= dot_period) { d3_phase = 0; }
    d4_phase++; if (d4_phase >= dot_period) { d4_phase = 0; }
    db = 0.20;
    da = 0.80;
    d0.sprite.SetOpacity ((db + da * tri (d0_phase, dot_period)) * f);
    d1.sprite.SetOpacity ((db + da * tri (d1_phase, dot_period)) * f);
    d2.sprite.SetOpacity ((db + da * tri (d2_phase, dot_period)) * f);
    d3.sprite.SetOpacity ((db + da * tri (d3_phase, dot_period)) * f);
    d4.sprite.SetOpacity ((db + da * tri (d4_phase, dot_period)) * f);
}
Plymouth.SetRefreshFunction (refresh);

# -- Boot / prompt / shutdown callbacks --
prompt.sprite = Sprite ();
prompt.sprite.SetZ (20);

fun display_normal_callback () {
    prompt.sprite.SetOpacity (0);
}
fun display_password_callback (prompt_text, bullets) {
    img = Image.Text (prompt_text + "  " + bullets, 0.88, 0.92, 1.0);
    prompt.sprite.SetImage (img);
    prompt.sprite.SetX (ox + (sw - img.GetWidth ()) / 2);
    prompt.sprite.SetY (oy + sh * 0.88);
    prompt.sprite.SetOpacity (1);
}
fun display_question_callback (prompt_text, entry) {
    img = Image.Text (prompt_text + "  " + entry, 0.88, 0.92, 1.0);
    prompt.sprite.SetImage (img);
    prompt.sprite.SetX (ox + (sw - img.GetWidth ()) / 2);
    prompt.sprite.SetY (oy + sh * 0.88);
    prompt.sprite.SetOpacity (1);
}
fun display_message_callback (text) { }
fun quit_callback () { }

Plymouth.SetDisplayNormalFunction   (display_normal_callback);
Plymouth.SetDisplayPasswordFunction (display_password_callback);
Plymouth.SetDisplayQuestionFunction (display_question_callback);
Plymouth.SetMessageFunction         (display_message_callback);
Plymouth.SetQuitFunction            (quit_callback);
