# BlueBird Kiosk OS boot/shutdown splash — premium "etched crest" theme.
#
# Layers (back->front): navy radial-glow background, a soft blue bloom, the
# cream Legacy Wall crest (blue keyed out so it floats and the glow shows
# through the engraving), and a row of gently-pulsing loader dots.
#
# MULTI-MONITOR (fixed 2026-06-22): the crest/glow/dots are drawn centered on
# EVERY connected output, each using that output's own geometry. The previous
# version positioned a single set of sprites off window 0 only — at SHUTDOWN
# both monitors are live in a lopsided layout (e.g. DP-1 1920x1080 @ x=0 + HDMI
# 3840x2160 @ x=1920), so window-0's geometry pushed the crest into a region
# neither panel could show centered and it vanished off both screens. Iterating
# Window.GetWidth(i) and centering per-window is correct at boot (one window) and
# shutdown (two+). Sprite coordinates are global; anchoring each sprite inside its
# own monitor's rect (ox,oy,sw,sh) lands it on-screen on that monitor.
#
# Animations run on the ~50Hz refresh callback, portable Plymouth-script only
# (counters + if + for). Animation state (fade/glow/dot phases) is shared so all
# monitors pulse in sync. Indexed sprite arrays (bg_sprite[i], em_sprite[i], ...)
# are the standard Plymouth multi-monitor idiom.

# Fallback colour for the instant before the image maps (deep navy, not flat brand-blue).
Window.SetBackgroundTopColor    (0.020, 0.027, 0.055);
Window.SetBackgroundBottomColor (0.012, 0.016, 0.035);

bg_image  = Image ("background.png");
em_image  = Image ("emblem.png");
gl_image  = Image ("glow.png");
dot_image = Image ("dot.png");

# -- Build the full splash on each monitor, centered on its own geometry --
# The `i < 8` cap is a safety bound: should a Plymouth build ever ignore the window
# index and return window-0's width for every i, the loop still terminates (it would
# just draw a few harmless overlapping copies) instead of spinning forever at load.
num_windows = 0;
for (i = 0; i < 8 && Window.GetWidth (i) > 0; i++) {
    sw = Window.GetWidth (i);
    sh = Window.GetHeight (i);
    ox = Window.GetX (i);
    oy = Window.GetY (i);

    # Background: navy radial glow scaled to THIS monitor.
    bg_sprite[i] = Sprite (bg_image.Scale (sw, sh));
    bg_sprite[i].SetX (ox);
    bg_sprite[i].SetY (oy);
    bg_sprite[i].SetZ (0);
    bg_sprite[i].SetOpacity (0);

    # Crest: cream emblem, ~30% monitor width, centred a touch high.
    em_w  = sw * 0.30;
    em_sc = em_w / em_image.GetWidth ();
    em_scaled = em_image.Scale (em_image.GetWidth () * em_sc, em_image.GetHeight () * em_sc);
    emw = em_scaled.GetWidth ();
    emh = em_scaled.GetHeight ();
    em_sprite[i] = Sprite (em_scaled);
    em_x[i]     = ox + (sw - emw) / 2;
    em_basey[i] = oy + (sh - emh) / 2 - sh * 0.04;
    em_settle[i] = sh * 0.022;
    em_sprite[i].SetX (em_x[i]);
    em_sprite[i].SetY (em_basey[i]);
    em_sprite[i].SetZ (10);
    em_sprite[i].SetOpacity (0);

    # Bloom: soft blue glow behind the crest, breathing.
    gl_w  = emw * 1.55;
    gl_sc = gl_w / gl_image.GetWidth ();
    gl_scaled = gl_image.Scale (gl_image.GetWidth () * gl_sc, gl_image.GetHeight () * gl_sc);
    gl_sprite[i] = Sprite (gl_scaled);
    gl_sprite[i].SetX (em_x[i] + emw / 2 - gl_scaled.GetWidth () / 2);
    gl_sprite[i].SetY (em_basey[i] + emh / 2 - gl_scaled.GetHeight () / 2);
    gl_sprite[i].SetZ (5);
    gl_sprite[i].SetOpacity (0);

    # Loader dots: five, centred low, staggered pulse.
    dot_d  = sw * 0.010;
    dot_sc = dot_d / dot_image.GetWidth ();
    dot_scaled = dot_image.Scale (dot_image.GetWidth () * dot_sc, dot_image.GetHeight () * dot_sc);
    dot_gap = dot_d * 2.0;
    dots_left = ox + (sw - dot_gap * 4) / 2 - dot_scaled.GetWidth () / 2;
    dots_y = oy + sh * 0.80;

    d0_sprite[i] = Sprite (dot_scaled); d0_sprite[i].SetX (dots_left + dot_gap*0); d0_sprite[i].SetY (dots_y); d0_sprite[i].SetZ (8); d0_sprite[i].SetOpacity (0);
    d1_sprite[i] = Sprite (dot_scaled); d1_sprite[i].SetX (dots_left + dot_gap*1); d1_sprite[i].SetY (dots_y); d1_sprite[i].SetZ (8); d1_sprite[i].SetOpacity (0);
    d2_sprite[i] = Sprite (dot_scaled); d2_sprite[i].SetX (dots_left + dot_gap*2); d2_sprite[i].SetY (dots_y); d2_sprite[i].SetZ (8); d2_sprite[i].SetOpacity (0);
    d3_sprite[i] = Sprite (dot_scaled); d3_sprite[i].SetX (dots_left + dot_gap*3); d3_sprite[i].SetY (dots_y); d3_sprite[i].SetZ (8); d3_sprite[i].SetOpacity (0);
    d4_sprite[i] = Sprite (dot_scaled); d4_sprite[i].SetX (dots_left + dot_gap*4); d4_sprite[i].SetY (dots_y); d4_sprite[i].SetZ (8); d4_sprite[i].SetOpacity (0);

    num_windows++;
}

# -- Shared animation state (all monitors pulse in sync) --
tick = 0;
fade_total = 35;

glow_phase  = 0;
glow_period = 170;

dot_period  = 90;
dot_stagger = 16;
d0_phase = 0;
d1_phase = dot_stagger * 1;
d2_phase = dot_stagger * 2;
d3_phase = dot_stagger * 3;
d4_phase = dot_stagger * 4;

fun tri (phase, period) {
    half = period / 2;
    if (phase < half) { return phase / half; }
    return (period - phase) / half;
}

fun refresh () {
    tick++;
    f = tick / fade_total;
    if (f > 1) { f = 1; }

    glow_phase++;
    if (glow_phase >= glow_period) { glow_phase = 0; }
    gb = 0.55 + 0.45 * tri (glow_phase, glow_period);

    d0_phase++; if (d0_phase >= dot_period) { d0_phase = 0; }
    d1_phase++; if (d1_phase >= dot_period) { d1_phase = 0; }
    d2_phase++; if (d2_phase >= dot_period) { d2_phase = 0; }
    d3_phase++; if (d3_phase >= dot_period) { d3_phase = 0; }
    d4_phase++; if (d4_phase >= dot_period) { d4_phase = 0; }

    db = 0.20;
    da = 0.80;
    o0 = (db + da * tri (d0_phase, dot_period)) * f;
    o1 = (db + da * tri (d1_phase, dot_period)) * f;
    o2 = (db + da * tri (d2_phase, dot_period)) * f;
    o3 = (db + da * tri (d3_phase, dot_period)) * f;
    o4 = (db + da * tri (d4_phase, dot_period)) * f;

    # Animate every monitor's sprite set in lock-step.
    for (i = 0; i < num_windows; i++) {
        bg_sprite[i].SetOpacity (f);
        em_sprite[i].SetOpacity (f);
        em_sprite[i].SetY (em_basey[i] + em_settle[i] * (1 - f));
        gl_sprite[i].SetOpacity (gb * f);
        d0_sprite[i].SetOpacity (o0);
        d1_sprite[i].SetOpacity (o1);
        d2_sprite[i].SetOpacity (o2);
        d3_sprite[i].SetOpacity (o3);
        d4_sprite[i].SetOpacity (o4);
    }
}
Plymouth.SetRefreshFunction (refresh);

# -- Boot / prompt / shutdown callbacks --
# Prompt (LUKS password / questions) anchored low-centre on window 0.
p_sw = Window.GetWidth (0);
p_sh = Window.GetHeight (0);
p_ox = Window.GetX (0);
p_oy = Window.GetY (0);

prompt.sprite = Sprite ();
prompt.sprite.SetZ (20);

fun display_normal_callback () {
    prompt.sprite.SetOpacity (0);
}
fun display_password_callback (prompt_text, bullets) {
    img = Image.Text (prompt_text + "  " + bullets, 0.88, 0.92, 1.0);
    prompt.sprite.SetImage (img);
    prompt.sprite.SetX (p_ox + (p_sw - img.GetWidth ()) / 2);
    prompt.sprite.SetY (p_oy + p_sh * 0.88);
    prompt.sprite.SetOpacity (1);
}
fun display_question_callback (prompt_text, entry) {
    img = Image.Text (prompt_text + "  " + entry, 0.88, 0.92, 1.0);
    prompt.sprite.SetImage (img);
    prompt.sprite.SetX (p_ox + (p_sw - img.GetWidth ()) / 2);
    prompt.sprite.SetY (p_oy + p_sh * 0.88);
    prompt.sprite.SetOpacity (1);
}
fun display_message_callback (text) { }
fun quit_callback () { }

Plymouth.SetDisplayNormalFunction   (display_normal_callback);
Plymouth.SetDisplayPasswordFunction (display_password_callback);
Plymouth.SetDisplayQuestionFunction (display_question_callback);
Plymouth.SetMessageFunction         (display_message_callback);
Plymouth.SetQuitFunction            (quit_callback);
