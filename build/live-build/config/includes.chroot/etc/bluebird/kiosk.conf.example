# BlueBird Kiosk OS — runtime configuration.
# Written by the first-boot wizard. Edits made here take effect on next reboot.
#
# All values are also exposed as environment variables to systemd units that
# include `EnvironmentFile=/etc/bluebird/kiosk.conf`.

# Backend root URL — almost always the production BlueBird host.
BLUEBIRD_BACKEND=https://bluebird-alerts.com

# School slug, set by the first-boot wizard.
SCHOOL_SLUG=

# Full URL the kiosk Chromium points at.
# Derived from BLUEBIRD_BACKEND + SCHOOL_SLUG at firstboot completion.
LEGACY_WALL_URL=

# Stable device identifier, generated at install time. Never rotate; used as
# the primary key for the kiosk_devices heartbeat row.
DEVICE_ID=

# Local admin server port. Loopback only; do not expose publicly.
ADMIN_PORT=7311

# Heartbeat interval (seconds). Backend rate-limits to one per 30s.
HEARTBEAT_INTERVAL_SEC=60

# ── Content mode (what this kiosk renders) ───────────────────────────────────
# DISPLAY_MODE selects the page the launcher loads:
#   legacy_wall (default) → the Legacy Wall board (LEGACY_WALL_URL)
#   signage               → a bound Beacon display (SIGNAGE_URL; set by heartbeat)
#   visitor               → the visitor check-in page (VISITOR_URL) — VMS Phase 2b
# DISPLAY_MODE=visitor turns this box into a front-desk visitor check-in kiosk.
# VISITOR_URL is <BLUEBIRD_BACKEND>/<SCHOOL_SLUG>/visitor-kiosk (the visitor_management
# add-on must be enabled for the tenant). The launcher arms it with ?kiosk_cache=1, so
# the emergency takeover still fires AND the on-device check-in proxy
# (127.0.0.1:7311/legacy-wall/api/visitor/checkin) authenticates the check-in with this
# kiosk's license bearer. Example, for a dedicated visitor kiosk:
#   DISPLAY_MODE=visitor
#   VISITOR_URL=https://bluebird-alerts.com/nen/visitor-kiosk
DISPLAY_MODE=legacy_wall
VISITOR_URL=
