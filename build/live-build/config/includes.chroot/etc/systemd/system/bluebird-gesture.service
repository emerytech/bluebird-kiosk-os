[Unit]
Description=BlueBird gesture daemon (5-finger long-press → admin overlay)
After=bluebird-kiosk.service
Wants=bluebird-kiosk.service
PartOf=bluebird-kiosk.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/bluebird-kiosk/src
ExecStart=/usr/bin/python3 -m bluebird_gesture
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# ProtectSystem=strict makes the whole tree read-only; the daemon must write the touch-to-wake
# override here (and chromium's admin-overlay user-data-dir lives under this path too).
ReadWritePaths=/var/lib/bluebird-kiosk
# Needs read access to /dev/input/event* to receive multitouch events.
SupplementaryGroups=input

[Install]
WantedBy=bluebird-kiosk.target
