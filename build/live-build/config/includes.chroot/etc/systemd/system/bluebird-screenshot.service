[Unit]
Description=BlueBird Kiosk — capture + upload screenshot for fleet console
After=network-online.target greetd.service
Wants=network-online.target
PartOf=bluebird-kiosk.target

[Service]
Type=oneshot
# Runs as root so it can `sudo -u bluebird-kiosk` to access sway's
# wayland socket. The actual grim capture runs as bluebird-kiosk;
# curl runs as root (no harm — it only POSTs the PNG bytes).
ExecStart=/opt/bluebird-kiosk/bin/take-screenshot
# Bound by timer; doesn't restart on its own.
NoNewPrivileges=no
#
# Sandbox is deliberately LOOSE here. Tried PrivateTmp=yes +
# ProtectSystem=strict initially: grim couldn't talk to the sway
# wayland socket from inside the private namespace (sudo -u runs
# in the same systemd namespace as the parent, so XDG_RUNTIME_DIR
# resolves under the wrong /run mount). Field-confirmed 2026-06-09
# — manual run from SSH works fine, but the timer-fired service
# fails every time. Drop the sandbox bits to match the wayland
# session.
#
# The script itself is simple: read kiosk.conf, call grim, curl
# upload. No shell escape paths. The license token (the only sensitive
# input) is in /etc/bluebird/license.token, root-owned 0600, only
# read here.

[Install]
# No WantedBy — fired ONLY by bluebird-screenshot.timer.
