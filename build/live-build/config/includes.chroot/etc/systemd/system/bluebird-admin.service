[Unit]
Description=BlueBird Kiosk admin/firstboot FastAPI service (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bluebird-kiosk
Group=bluebird-kiosk
EnvironmentFile=-/etc/bluebird/kiosk.conf
Environment=PYTHONPATH=/opt/bluebird-kiosk/src
# WAYLAND_DISPLAY / XDG_RUNTIME_DIR are NOT set here — the bluebird-kiosk
# uid varies across installs, so display.py/system.py probe /run/user/<uid>
# at runtime and set these on each subprocess call.
WorkingDirectory=/opt/bluebird-kiosk
ExecStart=/usr/bin/python3 -m bluebird_kiosk.server --bind 127.0.0.1 --port 7311
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/bluebird /var/lib/bluebird-kiosk
# ProtectHome=yes would hide /run/user/<uid>, which breaks
# `swaymsg` integration — sway's IPC socket lives there and the
# admin server needs to send `exec` messages to spawn the kiosk
# overlay window. We leave /home + /root visible too; the user
# `bluebird-kiosk` has no $HOME beyond /var/lib/bluebird-kiosk.
ProtectHome=no
PrivateTmp=yes

[Install]
WantedBy=bluebird-kiosk.target
