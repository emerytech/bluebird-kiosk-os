[Unit]
Description=BlueBird Kiosk OS — check + apply latest install bootstrap
After=network-online.target
Wants=network-online.target

[Service]
# Triggered by:
#   • bluebird-update.timer (every 6h, via auto-update loop)
#   • Admin overlay "Check for updates" button (via systemctl start)
#
# The wrapper script /opt/bluebird-kiosk/bin/bluebird-update compares the
# local installed version against the remote /api/public/kiosk-os/version
# and only runs install.sh when they differ. So firing this every 6 hours
# is cheap if nothing has changed.
Type=oneshot
RemainAfterExit=no

WorkingDirectory=/tmp

EnvironmentFile=-/etc/bluebird/kiosk.conf
ExecStart=/opt/bluebird-kiosk/bin/bluebird-update

TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

[Install]
# Not WantedBy=anything — service is started on demand (timer + admin button).
