[Unit]
Description=BlueBird Kiosk heartbeat (POST device status every 60s)
After=network-online.target bluebird-kiosk.service
Wants=network-online.target
PartOf=bluebird-kiosk.target

[Service]
Type=simple
User=bluebird-kiosk
Group=bluebird-kiosk
EnvironmentFile=-/etc/bluebird/kiosk.conf
Environment=PYTHONPATH=/opt/bluebird-kiosk/src
ExecStart=/usr/bin/python3 -m bluebird_kiosk.services.heartbeat
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
# The heartbeat persists control-plane state to disk: the Beacon display
# assignment (DISPLAY_MODE/SIGNAGE_URL in kiosk.conf) and the cached power
# schedule (under /var/lib/bluebird-kiosk). Under ProtectSystem=strict those
# trees are read-only in the unit's namespace, so without this both writes
# fail with EROFS — silently breaking Beacon signage AND power scheduling.
# Mirrors bluebird-admin.service / bluebird-kiosk-sync.service.
ReadWritePaths=/etc/bluebird /var/lib/bluebird-kiosk
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=bluebird-kiosk.target
