#!/usr/bin/env bash
# Pick the right Chromium launcher based on first-boot state.
#
# Called from /etc/sway/config.d/bluebird-locked.conf as the only `exec` line.
# Runs inside the sway Wayland session, so Chromium has a display to attach to.
set -eu

CONF=/etc/bluebird/configured

if [[ -f "$CONF" ]]; then
    # Per-output independent mode: one Chromium per screen (different content each).
    LAYOUT=$(grep -oE '^DISPLAY_LAYOUT=.*' /etc/bluebird/kiosk.conf 2>/dev/null | head -1 \
             | cut -d= -f2 | tr -d '"'\''' )
    if [[ "$LAYOUT" == "independent" && -s /var/lib/bluebird-kiosk/display-content.json ]]; then
        exec /opt/bluebird-kiosk/bin/launch-kiosk-independent
    fi
    exec /opt/bluebird-kiosk/bin/launch-kiosk-chromium
else
    exec /opt/bluebird-kiosk/bin/bluebird-firstboot
fi
