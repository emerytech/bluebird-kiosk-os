#!/usr/bin/env bash
# Launch Chromium pointed at the Legacy Wall.
#
# URL selection (in order):
#   1. KIOSK_URL env override (explicit operator escape hatch)
#   2. LEGACY_WALL_URL from /etc/bluebird/kiosk.conf, reachable     ← preferred:
#      visual parity with the cloud Legacy Wall (sidebar, collections,
#      lightbox, idle slideshow, etc).
#   3. http://127.0.0.1:7311/legacy-wall (local renderer fed by the
#      kiosk-side sync cache — used when the kiosk has no internet).
#
# The local fallback is intentionally minimal: it shows a slideshow of
# already-synced media. Most schools will see the cloud version; the
# fallback only kicks in for a kiosk that lost WAN since boot.
set -eu

CONF=/etc/bluebird/kiosk.conf
ADMIN_PORT=7311
LOCAL_URL="http://127.0.0.1:${ADMIN_PORT}/legacy-wall"
CLOUD_URL=""

# shellcheck disable=SC1091
[[ -f "$CONF" ]] && source "$CONF"

# kiosk.conf may override ADMIN_PORT — recompute the local URL after sourcing.
LOCAL_URL="http://127.0.0.1:${ADMIN_PORT}/legacy-wall"
CLOUD_URL="${LEGACY_WALL_URL:-}"
# Beacon signage: when the heartbeat has bound this device to a Beacon display it
# writes DISPLAY_MODE=signage + SIGNAGE_URL into kiosk.conf (sourced above). An
# unbound kiosk leaves DISPLAY_MODE=legacy_wall and these are inert.
DISPLAY_MODE="${DISPLAY_MODE:-legacy_wall}"
SIGNAGE_URL="${SIGNAGE_URL:-}"

# Per-output independent mode (set by launch-kiosk-independent, one launch per screen):
#   KIOSK_FORCE_LEGACY_WALL=1  → ignore the single binding, resolve the Legacy Wall (probe+fallback)
#   KIOSK_OUTPUT_URL=<url>      → render this exact cloud URL (a Beacon display), arming kiosk_cache
# These override the kiosk.conf single binding for THIS launch only.
if [[ "${KIOSK_FORCE_LEGACY_WALL:-}" == "1" ]]; then
  DISPLAY_MODE="legacy_wall"
  SIGNAGE_URL=""
fi

# Wait for the local admin server first — needed either way (local
# renderer + diagnostic console). Without this wait, Chromium can fire
# before FastAPI binds and end up on a connection-refused error page.
HEALTH="http://127.0.0.1:${ADMIN_PORT}/_health"
for _ in $(seq 1 90); do
  if /usr/bin/python3 -c "
import sys, urllib.request
try:
    r = urllib.request.urlopen('$HEALTH', timeout=1)
    sys.exit(0 if r.status == 200 else 1)
except Exception:
    sys.exit(1)
" 2>/dev/null; then
    break
  fi
  sleep 1
done

# URL selection. Beacon signage (a kiosk bound to a Beacon display) takes
# precedence: commit to the cloud signage URL — there is no local signage
# renderer yet, so if WAN is down Chromium simply retries and the page loads
# when it returns. Otherwise probe the Legacy Wall cloud URL and, if reachable,
# use it for visual parity; else fall back to the local renderer. The operator
# KIOSK_URL override (below) still wins over both.
URL="$LOCAL_URL"
if [[ "$DISPLAY_MODE" == "signage" && -n "$SIGNAGE_URL" ]]; then
  URL="$SIGNAGE_URL"
elif [[ -n "$CLOUD_URL" ]]; then
  # Use a real-browser UA — Cloudflare/modsecurity in front of the
  # backend returns 403 to bare `Python-urllib/X.Y` requests, which
  # would mis-classify a healthy cloud as unreachable.
  if /usr/bin/python3 -c "
import sys, urllib.request
req = urllib.request.Request(
    '$CLOUD_URL',
    headers={'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 BlueBirdKioskProbe'}
)
try:
    r = urllib.request.urlopen(req, timeout=4)
    sys.exit(0 if r.status == 200 else 1)
except Exception:
    sys.exit(1)
" 2>/dev/null; then
    URL="$CLOUD_URL"
  fi
fi

# Explicit operator override wins over everything else.
if [[ -n "${KIOSK_URL:-}" ]]; then
  URL="$KIOSK_URL"
fi

# Per-output Beacon URL (independent mode) — like KIOSK_URL but treated as a cloud target so
# kiosk_cache=1 still gets appended below (which arms the emergency takeover on that screen).
KIOSK_OUTPUT_ARM=""
if [[ -n "${KIOSK_OUTPUT_URL:-}" ]]; then
  URL="$KIOSK_OUTPUT_URL"
  KIOSK_OUTPUT_ARM=1
fi

# Cloud Legacy Wall reads ?kiosk_cache=1 and (via a small inline JS
# shim at the top of the body) rewrites every image URL to point at
# the kiosk's local FastAPI server. The local server returns cached
# bytes in 25-170 ms from disk and 302s to cloud on miss. This is how
# we get instant per-image transitions WITHOUT building a separate
# local dashboard — the cloud page renders exactly as it always has,
# only the image fetches are diverted.
#
# Param is a bare flag (not ?cache_host=http://…) because Cloudflare's
# WAF rejects URLs with an http:// in the query as suspected SSRF
# (returns 403 before our origin even sees the request). The kiosk's
# local server is always at 127.0.0.1:7311 anyway, so the shim
# hardcodes that target — no need to thread the value through.
# Append for ANY cloud target — the Legacy Wall (CLOUD_URL) OR a Beacon signage
# display (SIGNAGE_URL). Besides the local image cache, kiosk_cache=1 is what ARMS
# the emergency-takeover poller embedded in the page; gating on ==CLOUD_URL alone
# left the takeover silently dead on a signage display (Beacon §13-C1).
if { { [[ -n "$CLOUD_URL" ]] && [[ "$URL" == "$CLOUD_URL" ]]; } \
     || { [[ -n "$SIGNAGE_URL" ]] && [[ "$URL" == "$SIGNAGE_URL" ]]; } \
     || [[ "${KIOSK_OUTPUT_ARM:-}" == "1" ]]; } \
   && [[ "$URL" != *"kiosk_cache=1"* ]]; then
  if [[ "$URL" == *\?* ]]; then
    URL="${URL}&kiosk_cache=1"
  else
    URL="${URL}?kiosk_cache=1"
  fi
fi

# Identify the Chromium window as a BlueBird kiosk so the cloud Legacy
# Wall can offer kiosk-only affordances (e.g. opening the local admin
# overlay from the settings menu). Real students on phones/desktops
# never see this UA suffix.
KIOSK_VERSION="$(cat /opt/bluebird-kiosk/VERSION 2>/dev/null || echo 0.0.0)"
UA_SUFFIX="BlueBirdKiosk/${KIOSK_VERSION}"
DEFAULT_UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36"

# Bundled MV3 extension (bluebird_kiosk_cache_ext) intercepts Legacy
# Wall image requests destined for bluebird-alerts.com and redirects
# them to http://127.0.0.1:7311/legacy-wall/media/<id>/<image|thumb>.
# The local admin server serves bytes out of /var/lib/bluebird-kiosk/
# media/ when present, or 302s back to the cloud on miss. Net effect:
# the operator sees the regular cloud dashboard (sidebar, lightbox,
# touch nav) but per-image latency drops from hundreds of ms over WiFi
# to ~25-170 ms from local SSD.
#
# `--allow-running-insecure-content` (already set below) is what lets
# the HTTPS cloud page load HTTP localhost images via the redirect.
CACHE_EXT_DIR=/opt/bluebird-kiosk/share/cache-ext
EXT_FLAG=""
if [[ -f "${CACHE_EXT_DIR}/manifest.json" ]]; then
  EXT_FLAG="--load-extension=${CACHE_EXT_DIR}"
fi

# NOTE: `--incognito` was REMOVED 2026-06-04.
#
# Chromium silently disables --load-extension when --incognito is also
# set (the extension is loaded but not "allow in incognito" — there's
# no CLI flag to enable that, only the per-extension toggle in
# chrome://extensions, which we can't drive on a headless kiosk). The
# DNR rules that redirect media requests to our local cache wouldn't
# fire. Field-confirmed: 0 chromium-originated requests reached the
# local server until --incognito was dropped.
#
# We replace its state-resetting effect with --user-data-dir pointed
# at a directory we wipe on each launch. Net effect:
#   - Same "fresh profile every boot" behavior (no cookie/history
#     buildup, no auth carryover, no autofill leaks)
#   - PLUS: extensions actually run
#   - PLUS: HTTP cache persists ACROSS the launch (we wipe the dir
#     BEFORE chromium starts, then chromium populates it; on the
#     next reboot the previous cache is gone) — same as incognito.
# Per-output independent mode gives each screen its own profile dir (a separate chromium
# instance — a shared dir would make the 2nd launch attach to the 1st via the singleton lock).
KIOSK_PROFILE_DIR="${KIOSK_PROFILE_OVERRIDE:-/var/lib/bluebird-kiosk/kiosk-chromium}"
rm -rf "$KIOSK_PROFILE_DIR" 2>/dev/null || true
mkdir -p "$KIOSK_PROFILE_DIR/Default"

# Pre-seed Preferences with extensions.ui.developer_mode = true.
# Chromium 137+ silently rejects --load-extension when developer mode
# is off in the profile, regardless of CLI feature flags. There is no
# CLI override — the toggle lives in chrome://extensions, which we
# can't drive on a headless kiosk. So we write the pref by hand. The
# launcher wipes $KIOSK_PROFILE_DIR on every start, so this file is
# always present and fresh.
cat > "$KIOSK_PROFILE_DIR/Default/Preferences" <<'PREF'
{
  "extensions": {
    "ui": {"developer_mode": true}
  }
}
PREF
chown -R bluebird-kiosk:bluebird-kiosk "$KIOSK_PROFILE_DIR" 2>/dev/null || true

# Minimum loading-screen display time. The branded "Preparing your wall"
# swaybg wallpaper is visible from sway start until Chromium paints over it at
# the exec below. On a fast kiosk (wall already reachable, warm cache) all the
# work above can finish in ~1s, so Chromium would cover the wallpaper almost
# instantly and the loading screen flashes by — looking like a glitch. Hold
# until at least MIN_LOADING_SECONDS have elapsed since this launcher started
# (≈ since the wallpaper appeared, both fire at sway startup) so the handoff
# always reads as deliberate. $SECONDS is bash's integer elapsed-runtime
# counter; the wait only ever ADDS time on a fast boot, never delays a slow
# one (a slow boot already exceeded the floor). Override via
# KIOSK_MIN_LOADING_SECONDS in /etc/bluebird/kiosk.conf; 0 disables it.
MIN_LOADING_SECONDS="${KIOSK_MIN_LOADING_SECONDS:-5}"
if [[ "$MIN_LOADING_SECONDS" -gt 0 && "$SECONDS" -lt "$MIN_LOADING_SECONDS" ]]; then
  sleep "$(( MIN_LOADING_SECONDS - SECONDS ))"
fi

# --disable-features list:
#   TranslateUI                                   — kill the "translate?" infobar
#   BlockInsecurePrivateNetworkRequests           ┐ allow https page →
#   PrivateNetworkAccessSendPreflights            │ http://127.0.0.1 fetch
#   PrivateNetworkAccessRespectPreflightResults   ┘ (old PNA opt-out)
#   LocalNetworkAccess                            ┐ Chromium 132+ replaced
#   LocalNetworkAccessChecks                      ┘ PNA with the new
#       "Local Network Access" permission API. Without these disabled,
#       chromium shows an "Access other apps and services on this
#       device" infobar/prompt instead of just letting the kiosk_cache
#       shim fetch http://127.0.0.1:7311/legacy-wall/media/<id>/image.
#       The fetch silently hangs until the user clicks Allow. The old
#       PNA feature-disable above does NOT cover this. Field-confirmed
#       on Chromium 148, 2026-06-09 at NEN.
#   DisableLoadExtensionCommandLineSwitch         — Chromium 137+ silently
#       ignores --load-extension unless this flag is disabled (or the
#       user toggles Developer Mode in chrome://extensions, which we
#       can't drive headlessly). Without this, the cache extension
#       below loads to nowhere and the kiosk still hits cloud for every
#       image. Field-confirmed 2026-06-04.
exec /usr/bin/chromium \
  --kiosk \
  --ozone-platform=wayland \
  --noerrdialogs \
  --no-first-run \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --disable-features=TranslateUI,BlockInsecurePrivateNetworkRequests,PrivateNetworkAccessSendPreflights,PrivateNetworkAccessRespectPreflightResults,LocalNetworkAccessChecks,LocalNetworkAccess,DisableLoadExtensionCommandLineSwitch \
  --password-store=basic \
  --check-for-update-interval=604800 \
  --start-fullscreen \
  --user-data-dir="$KIOSK_PROFILE_DIR" \
  ${EXT_FLAG} \
  --user-agent="${DEFAULT_UA} ${UA_SUFFIX}" \
  --allow-running-insecure-content \
  --disk-cache-size=104857600 \
  --app="$URL"
