#!/usr/bin/env bash
# Launch Chromium pointed at the local Legacy Wall renderer.
#
# Phase 3 of the kiosk-v2 local-cache effort: instead of pointing at the
# cloud URL (which fails when the kiosk's internet is down), we point at
# the on-device control plane at 127.0.0.1:7311/legacy-wall. That page
# reads from KioskLocalCache, which the sync service keeps current.
#
# Override path:
#   KIOSK_URL=https://bluebird-alerts.com/foo/legacy-wall launch-kiosk-chromium
# falls back to the cloud URL if someone explicitly asks for it.
set -eu

CONF=/etc/bluebird/kiosk.conf
ADMIN_PORT=7311
URL="http://127.0.0.1:${ADMIN_PORT}/legacy-wall"

if [[ -f "$CONF" ]]; then
  # shellcheck disable=SC1091
  source "$CONF"
  if [[ -n "${ADMIN_PORT:-}" ]]; then
    URL="http://127.0.0.1:${ADMIN_PORT}/legacy-wall"
  fi
fi

# Pre-configuration: if the firstboot wizard hasn't completed yet, the
# /legacy-wall route still works but shows the "Waiting for content" state.
# A friendlier path is to send Chromium to the wizard surface directly. But
# the gesture/launcher logic already handles that — this script only runs
# in post-configured mode.

# Allow an explicit env override (e.g. for cloud fallback testing).
if [[ -n "${KIOSK_URL:-}" ]]; then
  URL="$KIOSK_URL"
fi

# Wait for bluebird-admin.service to be reachable before launching Chromium.
# Without this, sway's `exec` fires Chromium immediately on session start —
# faster than systemd brings up the FastAPI server — and Chromium ends up
# stuck on a "connection refused" page (no URL bar in --kiosk to recover).
# Skip the wait if the URL is an explicit cloud override.
if [[ "$URL" == http://127.0.0.1:* ]]; then
  HEALTH="http://127.0.0.1:${ADMIN_PORT}/_health"
  for _ in $(seq 1 90); do
    if /usr/bin/python3 -c "
import sys, urllib.request
try:
    r = urllib.request.urlopen('$HEALTH', timeout=1)
    sys.exit(0 if r.status == 200 else 1)
except Exception:
    sys.exit(1)
" 2>/dev/null; then
      break
    fi
    sleep 1
  done
fi

exec /usr/bin/chromium \
  --kiosk \
  --noerrdialogs \
  --no-first-run \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --disable-features=TranslateUI \
  --password-store=basic \
  --check-for-update-interval=604800 \
  --start-fullscreen \
  --incognito \
  --app="$URL"
