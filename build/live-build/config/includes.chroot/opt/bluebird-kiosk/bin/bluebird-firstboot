#!/usr/bin/env bash
# Open the on-screen first-boot wizard in a fullscreen Chromium pointed at
# the local admin FastAPI server. Blocks until /etc/bluebird/configured exists.
set -eu

URL="http://127.0.0.1:7311/firstboot"
HEALTH="http://127.0.0.1:7311/_health"

# Wait for the admin server to come up. Use python3 instead of curl: python3
# is guaranteed by our apt package list, curl is not.
for _ in $(seq 1 60); do
  if /usr/bin/python3 -c "
import sys, urllib.request
try:
    r = urllib.request.urlopen('$HEALTH', timeout=1)
    sys.exit(0 if r.status == 200 else 1)
except Exception:
    sys.exit(1)
" 2>/dev/null; then
    break
  fi
  sleep 1
done

exec /usr/bin/chromium \
  --kiosk \
  --ozone-platform=wayland \
  --noerrdialogs \
  --no-first-run \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --password-store=basic \
  --app="$URL"
