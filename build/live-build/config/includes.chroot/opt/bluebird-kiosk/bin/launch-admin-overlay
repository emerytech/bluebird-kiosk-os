#!/usr/bin/env bash
# Launch a separate Chromium window pointing at the PIN-gated admin overlay.
# Used by:
#   - the gesture daemon (5-finger long-press on a touchscreen)
#   - the Ctrl+Alt+B sway keybinding (keyboard fallback, useful on kiosks
#     with no touchscreen or while diagnosing)
#   - the cloud Legacy Wall settings menu (POST to local admin server)
#
# Idempotency: if an admin Chromium is already running with our
# --user-data-dir, Chromium's singleton lock makes the new process a
# no-op AND the original (possibly hidden) window stays put. Worst case,
# repeated clicks pile up zero-size tiled siblings (we hit this live).
# So: pkill any existing admin Chromium first, sleep briefly, then
# start fresh. Always produces a new, visible window.
set -eu

USER_DATA_DIR=/var/lib/bluebird-kiosk/admin-chromium

# Match by --user-data-dir — this distinguishes the admin overlay from the
# kiosk Chromium even though both share /usr/bin/chromium.
pkill -f -- "--user-data-dir=$USER_DATA_DIR" 2>/dev/null || true
# Brief wait so chromium releases the singleton lock + closes its windows.
sleep 0.5

# The kiosk Chromium is fullscreen, and sway's global fullscreen state hides
# every other window. Unfullscreen it before launching the overlay so our
# admin window actually appears. A small for_window rule re-fullscreens the
# kiosk when the admin window closes (see bluebird-locked.conf).
if command -v swaymsg >/dev/null 2>&1; then
  # Find the running sway socket (varies by sway PID across boots).
  SWAY_SOCK="$(ls /run/user/$(id -u)/sway-ipc.$(id -u).*.sock 2>/dev/null | head -1 || true)"
  if [[ -n "${SWAY_SOCK:-}" ]]; then
    SWAYSOCK="$SWAY_SOCK" swaymsg \
      '[app_id="chrome-.*legacy-wall.*"] fullscreen disable' >/dev/null 2>&1 || true
  fi
fi

exec /usr/bin/chromium \
  --ozone-platform=wayland \
  --new-window \
  --no-first-run \
  --noerrdialogs \
  --password-store=basic \
  --incognito \
  --disable-features=PasswordManager,AutofillServerCommunication,AutofillPasswordGeneration \
  --user-data-dir="$USER_DATA_DIR" \
  --window-size=800,1000 \
  --app="http://127.0.0.1:7311/admin"
