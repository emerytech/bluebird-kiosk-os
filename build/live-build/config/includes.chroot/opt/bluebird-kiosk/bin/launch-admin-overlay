#!/usr/bin/env bash
# Launch a separate Chromium window pointing at the PIN-gated admin overlay.
# Used by:
#   - the gesture daemon (5-finger long-press on a touchscreen)
#   - the Ctrl+Alt+B sway keybinding (keyboard fallback, useful on kiosks
#     with no touchscreen or while diagnosing)
#   - the cloud Legacy Wall settings menu (POST to local admin server)
#
# Idempotency: if an admin Chromium is already running with our
# --user-data-dir, Chromium's singleton lock makes the new process a
# no-op AND the original (possibly hidden) window stays put. Worst case,
# repeated clicks pile up zero-size tiled siblings (we hit this live).
# So: pkill any existing admin Chromium first, sleep briefly, then
# start fresh. Always produces a new, visible window.
set -eu

USER_DATA_DIR=/var/lib/bluebird-kiosk/admin-chromium

# Match by --user-data-dir — this distinguishes the admin overlay from the
# kiosk Chromium even though both share /usr/bin/chromium.
pkill -f -- "--user-data-dir=$USER_DATA_DIR" 2>/dev/null || true
# Brief wait so chromium releases the singleton lock + closes its windows.
sleep 0.5

# The kiosk Chromium is fullscreen, and sway's global fullscreen state hides
# every other window. Unfullscreen the kiosk before AND after launching the
# admin Chromium — `--kiosk --start-fullscreen` makes chromium re-assert
# fullscreen via the Wayland protocol immediately after a fresh respawn,
# so one shot isn't enough to win the race. The for_window rule for the
# admin window also sets `sticky enable`, which keeps it visible even when
# another window is in sway's global fullscreen state.
unfullscreen_kiosk() {
  if ! command -v swaymsg >/dev/null 2>&1; then
    return
  fi
  local sock
  sock="${SWAYSOCK:-}"
  if [[ -z "$sock" ]]; then
    sock="$(ls /run/user/$(id -u)/sway-ipc.$(id -u).*.sock 2>/dev/null | head -1 || true)"
  fi
  [[ -z "$sock" ]] && return
  # Match ANY chrome- app_id, not just URLs containing "legacy-wall".
  # The kiosk URL has gone through several layouts:
  #   chrome-bluebirdalerts.com__nen_legacy-wall-Default  (early)
  #   chrome-bluebirdalerts.com__nen-Default              (when slug-only
  #                                                       URLs landed)
  #   chrome-legacy.ets3d.com__nen-Default                (white-label
  #                                                       domain, current)
  # Disabling fullscreen on the admin overlay window itself is a no-op
  # (it isn't fullscreen), so the broader match has no side-effect.
  SWAYSOCK="$sock" swaymsg \
    '[app_id="^chrome-.*"] fullscreen disable' >/dev/null 2>&1 || true
}

# Pre-launch unfullscreen so the admin chromium's first map sees a
# non-fullscreen workspace.
unfullscreen_kiosk

# Spawn a background watcher that re-asserts unfullscreen for ~3 s after
# admin launch, in case chromium re-requests fullscreen post-map. The
# loop exits on its own.
(
  for i in 1 2 3 4 5 6; do
    sleep 0.25
    unfullscreen_kiosk
  done
) &

# If the caller passed BLUEBIRD_PREAUTH (cloud Legacy Wall "Kiosk Settings"
# entry point), pass it through to the page as a URL param. admin.js
# consumes ?preauth=... and short-circuits the local PIN screen — the
# operator already authenticated in the BlueBird admin console upstream.
URL="http://127.0.0.1:7311/admin"
if [[ -n "${BLUEBIRD_PREAUTH:-}" ]]; then
  URL="${URL}?preauth=${BLUEBIRD_PREAUTH}"
fi

exec /usr/bin/chromium \
  --ozone-platform=wayland \
  --new-window \
  --no-first-run \
  --noerrdialogs \
  --password-store=basic \
  --incognito \
  --disable-features=PasswordManager,AutofillServerCommunication,AutofillPasswordGeneration \
  --user-data-dir="$USER_DATA_DIR" \
  --window-size=800,1000 \
  --app="$URL"
