#!/usr/bin/env python3
"""BlueBird Kiosk OS — multi-display manager.

Makes a freshly plugged-in HDMI/DP display light up with the board, and mirrors the board to
every connected output by default (the common signage case: a hallway with N identical screens).
Runs inside the sway session (sway `exec`), so it has SWAYSOCK/WAYLAND_DISPLAY.

Design (deliberately conservative — must not regress the single-display, life-safety path):
- Idempotent + event-driven. It only issues a swaymsg command when an output is actually
  disabled or mispositioned, then re-checks on every sway `output` event (hotplug / unplug /
  mode change). Steady state issues nothing, so there's no command churn and no event-feedback
  loop (a command we send would emit an event, but the follow-up reconcile finds nothing to do).
- SINGLE DISPLAY: the one output is already enabled at (0,0), so the manager does nothing at
  all — behaviour is identical to before this existed.
- It never disables or repositions during normal operation beyond the origin-stack, and it does
  NOT fight the power scheduler: a DPMS-off output is still `active`, so we don't re-enable it;
  the scheduler's `output * dpms ...` covers any output we add.

Mode — /etc/bluebird/kiosk.conf  KIOSK_DISPLAY_MODE:
  mirror (default)  every output stacked at (0,0); the fullscreen board shows on all of them.
  extend            leave sway's default side-by-side layout; we only ensure each output is on.

NOTE: mirroring identical screens is clean; mixed resolutions mirror the shared top-left region
(the smaller panel shows a crop). Per-output independent content (each screen a different Beacon
display) is a deliberate future step, not this.
"""
from __future__ import annotations

import json
import subprocess
import time
from pathlib import Path

CONF = Path("/etc/bluebird/kiosk.conf")
# Operator-confirmed rotation/mode/brightness, written by the admin server (display.py
# persist_settings). Re-applied here on session start + on hotplug so settings survive a reboot
# or unattended self-update — a portrait hallway board stays portrait.
SETTINGS_PATH = Path("/var/lib/bluebird-kiosk/display-settings.json")
# Current output inventory, written here for the heartbeat to report to the fleet console (the
# heartbeat is sandboxed and can't reach the sway socket itself). Feeds per-output content
# binding — the admin sees each kiosk's output names.
INVENTORY_PATH = Path("/var/lib/bluebird-kiosk/outputs.json")


def _mode() -> str:
    try:
        for line in CONF.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line.startswith("KIOSK_DISPLAY_MODE="):
                val = line.split("=", 1)[1].strip().strip('"').strip("'").lower()
                return val or "mirror"
    except OSError:
        pass
    return "mirror"


def _sway(*args) -> None:
    try:
        subprocess.run(["swaymsg", *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass


def _outputs() -> list:
    try:
        r = subprocess.run(["swaymsg", "-t", "get_outputs"],
                           capture_output=True, text=True, timeout=10)
        return json.loads(r.stdout) or []
    except Exception:  # noqa: BLE001 — any failure: treat as no outputs, retry next event
        return []


def _load_saved() -> dict:
    try:
        return json.loads(SETTINGS_PATH.read_text(encoding="utf-8")) or {}
    except (OSError, ValueError):
        return {}


def _mode_str(o: dict) -> str:
    cm = o.get("current_mode") or {}
    w, h, r = cm.get("width"), cm.get("height"), cm.get("refresh")
    if w and h:
        return "%dx%d@%dHz" % (w, h, round(r / 1000)) if r else "%dx%d" % (w, h)
    rect = o.get("rect") or {}
    if rect.get("width") and rect.get("height"):
        return "%dx%d" % (rect["width"], rect["height"])
    return ""


def _write_inventory(outs: list) -> None:
    inv = [{"name": o.get("name"), "mode": _mode_str(o),
            "active": bool(o.get("active", False)), "transform": o.get("transform")}
           for o in outs if o.get("name")]
    try:
        INVENTORY_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = INVENTORY_PATH.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(inv), encoding="utf-8")
        tmp.replace(INVENTORY_PATH)
    except OSError:
        pass


def reconcile(mirror: bool, restored: set) -> None:
    saved_outs = (_load_saved().get("outputs") or {})
    outs = _outputs()
    present = set()
    for o in outs:
        name = o.get("name")
        if not name:
            continue
        present.add(name)
        if not o.get("active", False):
            _sway("output", name, "enable")          # light up a newly plugged / disabled output
        if mirror:
            rect = o.get("rect") or {}
            if rect.get("x") != 0 or rect.get("y") != 0:
                _sway("output", name, "position", "0", "0")   # stack at origin == mirror
        # Restore saved rotation/mode ONCE per appearance (boot + each re-plug). Doing it once,
        # not every event, means we don't fight a live operator change between events.
        s = saved_outs.get(name)
        if s and name not in restored:
            t = s.get("transform")
            if t and o.get("transform") != t:
                _sway("output", name, "transform", str(t))
            m = s.get("mode")
            if m:
                _sway("output", name, "mode", str(m))
            restored.add(name)
    restored.intersection_update(present)            # drop unplugged outputs so a re-plug re-applies
    _write_inventory(outs)                           # publish for the heartbeat to report


def _apply_brightness() -> None:
    b = _load_saved().get("brightness")
    if isinstance(b, int) and 1 <= b <= 100:
        try:
            subprocess.run(["brightnessctl", "set", "%d%%" % b], capture_output=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            pass


def main() -> int:
    mirror = (_mode() != "extend")
    restored: set = set()
    _apply_brightness()                              # backlight is global — restore once at start
    while True:
        try:
            reconcile(mirror, restored)
            # Block on sway output events; each line == one hotplug/unplug/mode change.
            proc = subprocess.Popen(
                ["swaymsg", "-t", "subscribe", "-m", '["output"]'],
                stdout=subprocess.PIPE, text=True,
            )
            for _line in proc.stdout:  # type: ignore[union-attr]
                reconcile(mirror, restored)
        except Exception:  # noqa: BLE001 — never let the manager die; back off and re-attach
            pass
        time.sleep(2)


if __name__ == "__main__":
    raise SystemExit(main())
