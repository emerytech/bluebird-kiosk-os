#!/usr/bin/env bash
# Apply an operator-chosen login password, sent from the super-admin console.
#
# Runs as root from bluebird-reset-access.service, which the heartbeat starts
# when the fleet console enqueues a password reset. The heartbeat itself runs as
# bluebird-kiosk with NoNewPrivileges=yes and cannot change a credential — that
# separation is deliberate, so the privileged half lives here and does exactly
# one thing.
#
# We never receive the plaintext. The server converts the operator's password to
# a crypt(3) SHA-512 record the moment it is submitted and ships only that, so
# the password itself exists nowhere on this device, in the command queue, or in
# any backup of the platform DB. `chpasswd -e` writes the record straight to
# /etc/shadow.
set -euo pipefail

REQUEST=/var/lib/bluebird-kiosk/access-reset.request
KIOSK_USER=bluebird

# The staged request is credential material: remove it on every exit path,
# including the failure ones.
cleanup() { rm -f "$REQUEST"; }
trap cleanup EXIT

if [ ! -s "$REQUEST" ]; then
  echo "no reset request staged at $REQUEST" >&2
  exit 2
fi

SHADOW="$(/usr/bin/python3 -c '
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("shadow", ""))
except Exception:
    pass
' "$REQUEST")"

if [ -z "$SHADOW" ]; then
  echo "reset request contained no password hash" >&2
  exit 3
fi

# Re-validate the shape here rather than trusting the caller. This value is fed
# to chpasswd, and it arrived over the network — the heartbeat already checks
# it, but this script is the privileged half and does its own check.
if ! printf '%s' "$SHADOW" | grep -Eq '^\$6\$[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{86}$'; then
  echo "password hash is not a valid SHA-512 crypt record" >&2
  exit 4
fi

if ! id -u "$KIOSK_USER" >/dev/null 2>&1; then
  echo "target account does not exist: $KIOSK_USER" >&2
  exit 5
fi

# -e: the value is already hashed. Piped rather than passed as an argument so
# the record never appears in the process list.
printf '%s:%s\n' "$KIOSK_USER" "$SHADOW" | chpasswd -e

# A locked account (set by install.sh --lockdown) would still refuse the new
# password, which would look like the reset silently failed.
passwd -u "$KIOSK_USER" >/dev/null 2>&1 || true

echo "password updated for ${KIOSK_USER}"
